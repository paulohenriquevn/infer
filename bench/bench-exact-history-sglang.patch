--- /dev/null
+++ b/tests/test_agent_exact_history.py
@@ -0,0 +1,57 @@
+"""Exact agent history on SGLang.
+
+The agents scenario appends the model's own output token IDs to the next turn
+so that the prefix cache can reuse the whole previous request. vLLM returns
+them through logprobs with return_tokens_as_token_ids; SGLang returns them in
+choices[].token_ids when the request sets return_token_ids. Without exact IDs
+on one engine, an A/B between engines measures the harness, not the cache.
+No GPU or server is needed.
+"""
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+
+
+MODULE_PATH = Path(__file__).resolve().parents[1] / "llm_decode_bench.py"
+SPEC = importlib.util.spec_from_file_location("llm_decode_bench_exact", MODULE_PATH)
+BENCH = importlib.util.module_from_spec(SPEC)
+assert SPEC.loader is not None
+SPEC.loader.exec_module(BENCH)
+
+
+def make_ctx(engine, prompt_mode="token_ids"):
+    return SimpleNamespace(
+        engine=engine,
+        model="m",
+        settings=SimpleNamespace(temperature=None),
+        prompts=SimpleNamespace(mode=prompt_mode),
+    )
+
+
+def test_sglang_payload_asks_for_output_token_ids():
+    payload = BENCH.sched_payload(make_ctx(BENCH.ENGINE_SGLANG), [1, 2, 3], 8, collect_ids=True)
+    assert payload["return_token_ids"] is True
+    assert "return_tokens_as_token_ids" not in payload
+
+
+def test_vllm_payload_keeps_logprob_token_ids():
+    payload = BENCH.sched_payload(make_ctx(BENCH.ENGINE_VLLM), [1, 2, 3], 8, collect_ids=True)
+    assert payload["return_tokens_as_token_ids"] is True
+    assert payload["logprobs"] == 1
+    assert "return_token_ids" not in payload
+
+
+def test_sglang_chunk_token_ids_are_read():
+    chunk = {"choices": [{"index": 0, "text": "ab", "token_ids": [17, 42]}]}
+    assert BENCH.sched_chunk_token_ids(chunk) == [17, 42]
+
+
+def test_vllm_chunk_token_ids_are_still_read():
+    chunk = {"choices": [{"logprobs": {"tokens": ["token_id:5", "token_id:9"]}}]}
+    assert BENCH.sched_chunk_token_ids(chunk) == [5, 9]
+
+
+def test_exact_history_on_both_engines_only_with_token_id_prompts():
+    assert BENCH.sched_exact_history(make_ctx(BENCH.ENGINE_VLLM))
+    assert BENCH.sched_exact_history(make_ctx(BENCH.ENGINE_SGLANG))
+    assert not BENCH.sched_exact_history(make_ctx(BENCH.ENGINE_SGLANG, prompt_mode="text"))
